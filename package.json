{
  "name": "create-archkit",
  "version": "0.1.0",
  "description": "CLI extensible para generar bases de proyectos y est\u00e1ndares de ingenier\u00eda",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Santy401",
    "email": "santiprocastellar6@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santy401/archkit.git"
  },
  "homepage": "https://github.com/Santy401/archkit#readme",
  "bugs": {
    "url": "https://github.com/Santy401/archkit/issues"
  },
  "bin": {
    "archkit": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "blueprints",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/check-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "pnpm build && node scripts/generate-example.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check && pnpm test:package",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.1.1"
  }
}
